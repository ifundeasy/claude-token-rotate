# claude-token-rotate settings.
#
# Copy this file to .env beside the binary (or main.py) and change what you need:
#     cp .env.example .env
# .env is git-ignored; this file is the documented, tracked template.
#
# Every key is listed here with its built-in default, so a fresh copy behaves exactly like no .env
# at all. An empty value also means "the default".
#
# Precedence, highest first:
#     command-line flag  >  CTR_* exported in the environment  >  .env  >  built-in default
# e.g. `CTR_LIMIT_7D=80 claude-token-rotate` overrides this file for one run.
#
# Syntax: KEY=value, one per line. `#` starts a comment (on its own line, or after a space in an
# unquoted value). A leading `export ` is allowed. Quote a value that contains ` #`.
# Booleans: true/false (also 1/0, yes/no, on/off). An unknown CTR_ key is an error, so a typo
# cannot silently do nothing.
#
# One-off actions stay flags only: --once, --json, --diagnose NAME, --no-cli, --from-env.
# The status-line scripts in plugin/ have their own STATUSLINE_* variables (see README).


# ─── files ──────────────────────────────────────────────────────────────────────────────────────
# Relative paths are taken beside the binary, not the directory you start it from.

# Credential list: a CSV with Name and CLAUDE_CODE_OAUTH_TOKEN columns. Holds live tokens — 0600.
CTR_CSV=token.csv

# Watch only these credentials (comma-separated names). Empty watches all of them.
CTR_ONLY=

# Indonesian national holidays (libur nasional, no cuti bersama) for the spend-down rule below.
# One YYYY-MM-DD per line. A missing file means weekends only.
CTR_HOLIDAYS=holidays.txt

# Shell file that records the live credential (and exports it with CTR_EXPORT_ENV=true).
CTR_ENV_FILE=~/.zshenv

# Claude Code credentials file kept in step with the live credential — what Claude Code actually
# reads. Empty = ~/.claude/.credentials.json, or under $CLAUDE_CONFIG_DIR when that is set.
CTR_CREDS_FILE=

# Append every reading (one row per credential per refresh) to this CSV. Empty = no log.
CTR_LOG=


# ─── dashboard ──────────────────────────────────────────────────────────────────────────────────

# Seconds between refreshes (5-3600; `+`/`-` change it while running). Every refresh costs one
# tiny API call per credential — the only way to read the quota headers.
CTR_INTERVAL=60

# Per-probe HTTP timeout, seconds.
CTR_TIMEOUT=30

# Starting view: b = all windows, h = 5h, w = 7d, o = extra credits.
CTR_VIEW=b

# Starting row order: csv, 5h, 7d, ov (extra-credit spend), name, r5h / r7d (soonest reset).
# Clicking a column header changes it while running; a second click reverses it.
CTR_SORT=csv

# Ring the terminal bell when any window crosses this percentage. Empty = off.
CTR_ALERT=

# Extra-credit cap, so the EXTRA column reads as money: a dollar amount, `auto` (read from
# /api/oauth/usage, needs one interactive Claude Code login on this machine) or `off`.
CTR_CAP=auto

# ANSI colour (also off whenever NO_COLOR is set or the output is not a terminal).
CTR_COLOR=true

# Show the live credential in the terminal title.
CTR_TITLE=true

# Take mouse clicks, for header sorting. While on, drag-to-select needs Shift held.
CTR_MOUSE=true

# Desktop notification when the live credential goes past its limits while a Claude Code session
# on this machine still holds it.
CTR_NOTIFY=true


# ─── rotation ───────────────────────────────────────────────────────────────────────────────────

# What auto-rotate may do: off (write nothing), park (keep the best credential recorded but
# switched off), on (swap it in). Empty = resume whatever `T` was last set to.
CTR_ROTATE_MODE=

# A credential is USABLE while its 5h window is below this percent. Usage is published in whole
# percent, so 61 means "at most 60%". Past it, auto-rotate swaps the live credential out.
CTR_LIMIT_5H=61

# ...and while its weekly (7d) window is below this percent: 66 means "at most 65%".
CTR_LIMIT_7D=66

# Least time between two automatic swaps, seconds, so nothing thrashes.
CTR_ROTATE_GAP=15

# Rebalance: spend first the week that resets first. While the live credential is fine, a usable
# credential whose weekly reset comes more than CTR_RESET_TIE sooner takes over (only with `on`,
# never over a pin). false = only rotate once the live credential is past its limits.
CTR_REBALANCE=true

# Rebalance skips a credential whose readings moved within this many minutes — somebody is on it.
# This machine's own use does not count.
CTR_REBALANCE_IDLE=30

# A replacement needs this many points left below each limit (with the defaults: 5h at most 55%,
# weekly at most 60%). When none has that much, any usable one will do.
CTR_MIN_HEADROOM=5

# When picking a replacement, the soonest weekly reset wins; weekly resets closer together than
# this many minutes count as a tie, and then the soonest 5h reset decides.
CTR_RESET_TIE=60

# The live credential (pinned by hand with `p` or not) that is over its 5h limit is kept when its 5h
# window resets within this many minutes, since the quota is about to come back...
CTR_PIN_GRACE=60

# ...but only until its 5h window reaches this percent.
CTR_PIN_CEILING=95


# ─── spend down before the weekly reset ─────────────────────────────────────────────────────────
# Whatever is left of a weekly window at its reset is lost. In off hours — Saturday, Sunday, a date
# in CTR_HOLIDAYS, and every night from CTR_NIGHT_FROM to CTR_NIGHT_UNTIL (so a weekend runs
# Friday 22:00 to Monday 07:00) — auto-rotate makes a credential live with BOTH limits waived
# when all of these hold:
#   - its weekly window resets in under CTR_BURN_WINDOW minutes, with quota left (< 100%, not
#     refused);
#   - no session on this machine uses it (not the live credential, no session carries it);
#   - its 5h and 7d readings have not moved for CTR_BURN_IDLE minutes, so nobody anywhere is on it
#     (this machine's own use does not count).
# A candidate whose 5h window is already at CTR_PIN_CEILING waits until that window resets. The
# live credential itself, with its week about to be lost, is kept instead of handed to a later
# one. The soonest reset goes first, also during a spend-down: one that loses its week more than
# CTR_RESET_TIE earlier takes over. It is held while it is still off hours (a weekend hold ends
# at Monday 07:00), until its weekly reset (or an earlier one), a refusal or a full week, or a
# swap by hand (p, z, e). A pin made with `p` outranks it. Only with CTR_ROTATE_MODE / `T` = on;
# in park and off it does nothing.

# Turn the rule on or off.
CTR_BURN=true

# Minutes before the weekly reset in which a credential qualifies (420 = 7 hours).
CTR_BURN_WINDOW=420

# Minutes its readings must have stood still while watched (120 = 2 hours).
CTR_BURN_IDLE=120

# A credential not watched yet — just after the dashboard starts, or after hours it could not
# watch — counts as idle, so a spend-down can start right away instead of after CTR_BURN_IDLE.
# The clock is kept in data.json; readings that moved across a gap still count as use.
# false = always watch for CTR_BURN_IDLE first.
CTR_BURN_UNSEEN=true

# ...but never with less than this many minutes left before the reset: two swaps for a few
# minutes of spending are not worth it.
CTR_BURN_MIN=15

# Every night from this hour (local clock) counts as off hours — work ends at 17:00, and by 22:00
# nobody is on a shared credential for work. 24 = no nights, only weekends and holidays.
CTR_NIGHT_FROM=22

# ...until this hour in the morning. 0 = nights end at midnight.
CTR_NIGHT_UNTIL=7


# ─── what it may write ──────────────────────────────────────────────────────────────────────────

# Write the shell file at all. false makes p / T / z read-only (and implies no credentials write).
CTR_ENV_WRITE=true

# Write the Claude Code credentials file (Linux; macOS keeps the login in the Keychain).
# false leaves the shell file as the only way to hand a token over, as with CTR_EXPORT_ENV=true.
CTR_CREDS_WRITE=true

# Also EXPORT the token from the shell file (the old way). Sessions that inherit the variable
# ignore the credentials file and need a restart per swap.
CTR_EXPORT_ENV=false
